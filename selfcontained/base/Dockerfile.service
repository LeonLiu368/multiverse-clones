# slack-service — THE single image we build + push (ghcr.io/abundant-ai/slack-service).
# Contains: real Mattermost + Slack Web API gateway (:80) + seeder + agent tools (slack CLI +
# slack-mcp MCP server). Tasks build FROM this image; they only need to add their codebase.
# The chat to seed is mounted at /data/mattermost at run time (task-specific, not baked in).
FROM mattermost/mattermost-team-edition:8.1.1
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        postgresql-14 postgresql-client-14 sudo python3 python3-pip curl jq git && \
    pip3 install --no-cache-dir fastapi "uvicorn[standard]" httpx psycopg2-binary requests \
        "slack_sdk>=3.27" "mcp>=1.2" pytest && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY slackgw /opt/slackgw
COPY seed.py /opt/seed.py
COPY api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
COPY seed.sh /usr/local/bin/task-seed.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh /usr/local/bin/task-seed.sh

# Agent tools: slack CLI + slack-mcp MCP server. Baked here so tasks get them for free
# without copying any tool files. PYTHONPATH=/opt:/opt/slackcli makes the package importable.
COPY slackcli /opt/slackcli
# Wrappers only fix sys.path (the stdio MCP spawn strips PYTHONPATH, so the subprocess can't
# import slackcli otherwise). SLACK_API_URL/SLACK_BOT_TOKEN recovery lives in slackcli.client
# (_recover_env reads /proc/1/environ) so it works for both single- and multi-container layouts.
RUN printf '#!/usr/bin/env python3\nimport sys; sys.path[:0] = ["/opt", "/opt/slackcli"]\nfrom slackcli.cli import main\nmain()\n' \
        > /usr/local/bin/slack && \
    printf '#!/usr/bin/env python3\nimport sys; sys.path[:0] = ["/opt", "/opt/slackcli"]\nfrom slackcli.mcp_server import main\nmain()\n' \
        > /usr/local/bin/slack-mcp && \
    chmod +x /usr/local/bin/slack /usr/local/bin/slack-mcp

ENV PYTHONPATH=/opt:/opt/slackcli \
    MM_URL=http://localhost:8065 \
    MM_TEAM=test-demo \
    MM_ADMIN_USER=admin@demo.local \
    MM_ADMIN_PASS=AdminUser123! \
    SLACK_BOT_TOKEN=xoxb-acme-eval-0001 \
    DEBIAN_FRONTEND=noninteractive TZ=UTC
EXPOSE 80
ENTRYPOINT ["/bin/bash", "/usr/local/bin/api-entrypoint.sh"]
