# Agent container. The agent's "Slack" surface is curl + the official slack_sdk, configured the
# way a real Slack app is: SLACK_API_URL + SLACK_BOT_TOKEN in the environment. The backend is a
# neutral host (`api`); the agent never sees Mattermost, its port, /api/v4, or its headers.
FROM python:3.12-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl jq git ca-certificates bash && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir slack_sdk

# Real-Slack-idiomatic config, baked so every shell/exec session has it.
ENV SLACK_API_URL=http://api \
    SLACK_BOT_TOKEN=xoxb-acme-eval-0001

COPY main-entrypoint.sh /usr/local/bin/main-entrypoint.sh
RUN chmod +x /usr/local/bin/main-entrypoint.sh

WORKDIR /app
ENTRYPOINT ["/usr/local/bin/main-entrypoint.sh"]
