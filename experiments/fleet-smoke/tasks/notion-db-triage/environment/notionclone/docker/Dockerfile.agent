# The thin `notion-agent` image (R2.c) — tools ONLY, zero data, zero server source.
#
# An agent task's `main` container builds `FROM` this. It ships `notion-cli` and the
# `notion-mcp` MCP server (both thin HTTP clients over notionclone.client) but NOT
# the API server (`api/`) or the seed system (`seed/`, incl. the synthetic generator
# and the corpus producer) — so the agent box carries no seedable data and no source
# an agent could grep for an answer (R2.k leak rule). A build-time smoke test asserts
# the server/seed modules are absent and the clients still load.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[mcp]" && \
    PKG="$(python -c 'import notionclone, os; print(os.path.dirname(notionclone.__file__))')" && \
    rm -rf "$PKG/api" "$PKG/seed" && \
    rm -rf /tmp/build && \
    # smoke test: data-free agent (no server/seed source) + clients still load
    test ! -e "$PKG/api" && test ! -e "$PKG/seed" && \
    notion-cli --help >/dev/null && \
    python -c "import notionclone.cli.main, notionclone.mcp.server, notionclone.client" && \
    echo "thin notion-agent OK (no api/, no seed/; notion-cli + notion-mcp load)"

ENV NOTION_API_URL=http://notion:3000 \
    NOTION_TOKEN=notion-clone-token
WORKDIR /app
CMD ["sleep", "infinity"]
