  "issues": [
    {
      "id": "issue-bor-1",
      "identifier": "BOR-1",
      "title": "Witness sync leaking goroutines \u2014 goroutine count and memory climb after peer churn",
      "description": "After every wave of peer connects/disconnects the bor node's goroutine count ratchets up and never comes back down; memory follows. pprof shows thousands of goroutines parked in the witness request path \u2014 blocked on per-request channels with no cancellation, plus fire-and-forget drainer goroutines that never receive a close. When a peer drops mid-request the request goroutine never returns and its Cancel channel is never closed (peer==nil path), so downstream waiters leak too. We need the witness request path to always cancel/close on disconnect so goroutines and channels are released.",
      "state": {
        "id": "state-todo",
        "name": "Todo"
      },
