  "issues": [
    {
      "id": "issue-ops-1",
      "identifier": "OPS-1",
      "title": "Indexing failures under load \u2014 lock contention with no retry/backoff",
      "description": "Under bulk import, multiple workers try to open the Tantivy index writer at once. Instead of waiting/backing off and retrying, the first contender wins and the others immediately raise and drop the document on the floor. We see bursts of lock errors that all retry instantly (thundering herd) and a chunk of documents silently never get indexed. We want bounded retry with jittered backoff, and when the lock truly can't be acquired the work should be deferred (rescheduled) rather than lost, surfacing a clear SearchIndexLockError.",
      "state": {
        "id": "state-todo",
        "name": "Todo"
      },
