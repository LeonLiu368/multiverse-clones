    "type": "message",
    "ts": "1730942460.000000",
    "client_msg_id": "9016463963f853b2a3",
    "text": "right, 95% is too late. I'm changing my proposal to 90%",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "carol",
      "real_name": "Carol",
      "display_name": "carol",
