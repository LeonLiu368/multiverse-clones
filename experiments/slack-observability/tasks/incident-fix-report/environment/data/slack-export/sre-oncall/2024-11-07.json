    "client_msg_id": "ea6582417d53143632",
    "text": "exactly. 90% is the right threshold for critical budget. gives us time to react before we're completely burned out",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "alice",
      "real_name": "Alice",
