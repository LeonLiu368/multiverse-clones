    }
  },
  {
    "user": "U522B276A35",
    "type": "message",
    "ts": "1730943360.000000",
    "client_msg_id": "3cbcc1b47cdb7ed5e4",
    "text": "agreed. critical: error_rate >= 0.05 OR budget_consumed_pct > 90",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "alice",
      "real_name": "Alice",
      "display_name": "alice",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U86A8C2DA85",
    "type": "message",
    "ts": "1730944440.000000",
    "client_msg_id": "840d04a88bad084791",
    "text": "what about warning? we should have a lower threshold to catch degrading services before they hit critical",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "frank",
      "real_name": "Frank",
      "display_name": "frank",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U2A4B17B116",
    "type": "message",
    "ts": "1730944560.000000",
    "client_msg_id": "69ff02999b9234eb1b",
    "text": "what error rate for warning?",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "erin",
      "real_name": "Erin",
      "display_name": "erin",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U48181ACD22",
    "type": "message",
    "ts": "1730945640.000000",
    "client_msg_id": "5e4842c125c6a89136",
    "text": "I propose 0.02 - anything above 2% is worth watching",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "bob",
      "real_name": "Bob",
      "display_name": "bob",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U6525ABCCE7",
    "type": "message",
    "ts": "1730946660.000000",
    "client_msg_id": "2b628ee679a8a9bc12",
    "text": "2% seems too aggressive, we'll get warning spam",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "niaj",
      "real_name": "Niaj",
      "display_name": "niaj",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U28B92B56EE",
    "type": "message",
    "ts": "1730947800.000000",
    "client_msg_id": "cc7b76c62c0f3b02df",
    "text": "yeah I think 0.02 might be a bit tight. what about splitting the difference?",
