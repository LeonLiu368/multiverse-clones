#!/bin/sh
set -eu

export PYTHONPATH="/opt/ticketvector-runtime${PYTHONPATH:+:$PYTHONPATH}"
export WORLD_ISSUES_BACKEND="${WORLD_ISSUES_BACKEND:-fake}"
export WORLD_ISSUES_STATE_FILE="${WORLD_ISSUES_STATE_FILE:-/var/lib/ticketvector/state.json}"
export WORLD_ISSUES_ACTOR="${WORLD_ISSUES_ACTOR:-agent}"
export WORLD_ISSUES_OUTPUT="${WORLD_ISSUES_OUTPUT:-json}"
export WORLD_ISSUES_AGENT_MODE="${WORLD_ISSUES_AGENT_MODE:-1}"
export PLANE_BASE_URL="${PLANE_BASE_URL:-http://127.0.0.1:8765}"

server_log="/tmp/ticketvector-server.log"

healthcheck() {
  python3 - <<'PY'
import json
import sys
import urllib.request

try:
    with urllib.request.urlopen("http://127.0.0.1:8765/health", timeout=0.5) as response:
        payload = json.loads(response.read().decode("utf-8"))
    sys.exit(0 if payload.get("ok") else 1)
except Exception:
    sys.exit(1)
PY
}

if ! healthcheck; then
  python3 -m world_issues.server >"$server_log" 2>&1 &
  for _ in $(seq 1 50); do
    if healthcheck; then
      break
    fi
    sleep 0.1
  done
fi

if ! healthcheck; then
  echo "ticketvector service failed to become ready" >&2
  cat "$server_log" >&2 || true
  exit 1
fi

exec "$@"
