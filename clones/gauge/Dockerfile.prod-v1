# gauge-service:prod-v1 — the base gateway image with a REAL observability corpus baked in.
#
# FROM the data-free base (:empty); bake the corpus state.json to GAUGE_STATE_FILE. The
# entrypoint serves whatever GAUGE_STATE_FILE points at, so this image needs NO fixture
# mount — it serves the full corpus out of the box from a cold `docker compose up`. A task
# switches empty <-> prod-v1 by the image tag ALONE; on prod-v1 any per-task fixture mount
# is irrelevant because the baked corpus is already in the image at /srv/gauge/state.json.
#
# Build context must contain `examples/data/gauge/state.json` (the corpus).
ARG BASE=ghcr.io/abundant-ai/gauge-service:empty
FROM ${BASE}

COPY examples/data/gauge/state.json /srv/gauge/state.json

# Point the seed at the baked corpus; keep the runtime (mutable) state on a writable path.
ENV GAUGE_STATE_FILE=/srv/gauge/state.json \
    GAUGE_RUNTIME_STATE_FILE=/var/lib/gauge/state.json
# (entrypoint, port, healthcheck, EXPOSE inherited from the base)
