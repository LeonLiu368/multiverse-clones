# The thin `figma-agent` image — tools ONLY, zero data, zero server source.
#
# An agent task's `main` container builds `FROM` this. It ships `figma-cli` and the
# `figma-mcp` MCP server (both thin HTTP clients) but NOT the API server (`api/`) or
# the seed system (`seed/`, incl. the synthetic generator) — so the agent box carries
# no seedable data and no design-token source an agent could grep for an answer. A
# build-time smoke test asserts the server/seed modules are absent and the CLI loads.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[mcp]" && \
    PKG="$(python -c 'import figmaclone, os; print(os.path.dirname(figmaclone.__file__))')" && \
    rm -rf "$PKG/api" "$PKG/seed" && \
    rm -rf /tmp/build && \
    # smoke test: data-free agent (no server/seed source) + tools still load
    test ! -e "$PKG/api" && test ! -e "$PKG/seed" && \
    figma-cli --help >/dev/null && \
    python -c "import figmaclone.cli.main, figmaclone.mcp.server" && \
    echo "thin figma-agent OK (no api/, no seed/; figma-cli + figma-mcp load)"

ENV FIGMA_API_URL=http://figma:3000 \
    FIGMA_TOKEN=figma-clone-token
WORKDIR /app
CMD ["sleep", "infinity"]
