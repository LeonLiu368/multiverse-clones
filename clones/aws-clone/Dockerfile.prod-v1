# aws-clone-service:prod-v1 — the BAKED-DB gateway image.
#
# Bakes the seed corpus (state.json) INTO the image at a fixed path and points
# AWS_CLONE_STATE_FILE at it, so a cold `docker run` (or compose up) with NO
# mount boots healthy and serves the full corpus. Switching a task between the
# baked corpus and a custom workspace is the image TAG alone
# (:prod-v1 <-> :empty), never a code or compose-logic change. (Clone Standard R2.j)
#
# Build (from repo root, after the base image exists):
#   docker build -f Dockerfile.service -t aws-clone-service:base .
#   docker build -f Dockerfile.prod-v1 --build-arg BASE=aws-clone-service:base \
#     -t aws-clone-service:prod-v1 .
ARG BASE=aws-clone-service:base
FROM ${BASE}

# Corpus baked into the image; runtime state is a writable copy elsewhere so the
# baked seed stays pristine and read-only.
COPY examples/data/aws-clone/state.json /opt/aws-clone-corpus/state.json
ENV AWS_CLONE_STATE_FILE=/opt/aws-clone-corpus/state.json \
    AWS_CLONE_RUNTIME_STATE_FILE=/var/lib/aws-clone/state.json

# No VOLUME / mount required: the corpus travels inside the image layer.
