FROM localstack/localstack:3.8.1

ENV AWS_CLONE_STATE_FILE=/data/aws-clone/state.json \
    AWS_CLONE_RUNTIME_STATE_FILE=/var/lib/aws-clone/state.json \
    AWS_CLONE_ENABLE_ADMIN_API=0 \
    AWS_CLONE_BIND_HOST=0.0.0.0 \
    AWS_CLONE_ADMIN_PORT=80 \
    AWS_ENDPOINT_URL=http://localhost:4566 \
    AWS_DEFAULT_REGION=us-east-1 \
    SERVICES=s3,sqs,sns,dynamodb,events,logs,ssm,secretsmanager,iam,sts,lambda,kinesis \
    PYTHONPATH=/opt/aws-clone:/opt/awscli

USER root
RUN python -m pip install --no-cache-dir --target /opt/awscli \
      awscli==1.31.13 \
      awscli-local==0.22.0 \
      boto3==1.33.13 \
      botocore==1.33.13 && \
    mkdir -p /opt/aws-clone /data/aws-clone /var/lib/aws-clone

WORKDIR /opt/aws-clone
COPY aws_clone ./aws_clone
# IAM hybrid shim: ships INSIDE /opt/awscli so it travels with the AWS tools into agent
# containers and auto-loads via sitecustomize (covers moto/LocalStack's IAM gaps:
# simulate-principal-policy, simulate-custom-policy, generate/get-credential-report).
COPY aws_clone_shim /opt/awscli/aws_clone_shim
COPY sitecustomize.py /opt/awscli/sitecustomize.py
COPY bin/aws bin/awslocal bin/aws-clonectl /usr/local/bin/
COPY entrypoint.sh /usr/local/bin/aws-clone-entrypoint.sh
RUN chmod +x /usr/local/bin/aws /usr/local/bin/awslocal /usr/local/bin/aws-clonectl /usr/local/bin/aws-clone-entrypoint.sh

EXPOSE 4566 80
VOLUME ["/data/aws-clone", "/var/lib/aws-clone"]
HEALTHCHECK --interval=2s --timeout=2s --retries=60 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4566/_localstack/health', timeout=1).read(); urllib.request.urlopen('http://127.0.0.1/api/healthz', timeout=1).read()"
ENTRYPOINT ["/usr/local/bin/aws-clone-entrypoint.sh"]
