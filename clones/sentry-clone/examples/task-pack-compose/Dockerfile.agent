# Agent (`main`) container — the thing under test. Neutral python base, data-free,
# and carrying ONLY the agent's tools: the `sentry` CLI + the `sentry-mcp` MCP server,
# both thin HTTP clients of the gateway. The gateway's API/seed source (sentry_clone.server)
# is STRIPPED so the seeded corpus is neither greppable nor recomputable on the agent —
# the agent reaches state solely over HTTP at $SENTRY_URL. `sentry-clonectl` (admin) is
# deliberately NOT copied.
FROM sentry-clone-service:local AS sentry-tools

FROM python:3.10-slim

RUN useradd --create-home --shell /bin/sh agent
COPY --from=sentry-tools /usr/local/bin/sentry /usr/local/bin/sentry-mcp /usr/local/bin/
COPY --from=sentry-tools /opt/sentry-clone-cli /opt/sentry-clone-cli

# Strip the gateway's HTTP API + state/seed source from the agent image (R2.k):
# keep only the CLI/MCP client package. After this, `import sentry_clone.server` raises
# and no server/ source survives on the agent.
RUN rm -rf /opt/sentry-clone-cli/sentry_clone/server && \
    find /opt/sentry-clone-cli -name '__pycache__' -type d -prune -exec rm -rf {} +

ENV PYTHONPATH=/opt/sentry-clone-cli \
    SENTRY_URL=http://sentry \
    SENTRY_AUTH_TOKEN=test-token-acme-eval \
    SENTRY_ORG=acme

USER agent
WORKDIR /home/agent
CMD ["sleep", "infinity"]
