# Backend sidecar: runs real Mattermost (bound to 127.0.0.1, never exposed) + the Slack Web
# API gateway on :80. The agent only ever reaches the gateway by IP; Mattermost, its /api/v4,
# its :8065 port, and its server headers are not visible from the agent's container.
FROM mattermost/mattermost-team-edition:8.1.1
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        postgresql-14 postgresql-client-14 sudo python3 python3-pip curl jq && \
    pip3 install --no-cache-dir fastapi "uvicorn[standard]" httpx psycopg2-binary requests && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY slackgw /opt/slackgw
COPY seed.py /opt/seed.py
COPY api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
COPY seed.sh /usr/local/bin/task-seed.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh /usr/local/bin/task-seed.sh

ENV PYTHONPATH=/opt \
    MM_URL=http://localhost:8065 \
    MM_TEAM=test-demo \
    MM_ADMIN_USER=admin@demo.local \
    MM_ADMIN_PASS=AdminUser123! \
    SLACK_BOT_TOKEN=xoxb-acme-eval-0001 \
    DEBIAN_FRONTEND=noninteractive TZ=UTC
EXPOSE 80
ENTRYPOINT ["/bin/bash", "/usr/local/bin/api-entrypoint.sh"]
