#!/usr/bin/env bash
# `slack` — the workspace CLI the agent uses. It speaks Slack Web API-style methods
# (conversations.*, chat.*, users.*, admin.*) over the workspace. Read/diagnostic methods
# return Slack-shaped JSON (with fields like `is_archived` / `deleted`) so problems are
# discoverable; action methods perform the change. The agent only ever sees "slack".
#
# Run `slack help` to list methods. Unrecognized input is passed straight through.
set -uo pipefail
URL="${MM_URL:-http://mattermost:8065}"
WS="${MM_TEAM:-test-demo}"                       # the workspace (hidden from the agent)
ADMIN_U="${MM_ADMIN_USER:-admin@demo.local}"
ADMIN_P="${MM_ADMIN_PASS:-AdminUser123!}"

# Cached admin token for the read/diagnostic methods that use the HTTP API directly.
_token() {
  local f=/tmp/.slack_token
  if [ -s "$f" ]; then cat "$f"; return; fi
  curl -s -i -X POST "$URL/api/v4/users/login" -H 'Content-Type: application/json' \
    -d "{\"login_id\":\"$ADMIN_U\",\"password\":\"$ADMIN_P\"}" \
    | tr -d '\r' | awk 'tolower($1)=="token:"{print $2}' | tee "$f"
}
_team_id() { curl -s -H "Authorization: Bearer $(_token)" "$URL/api/v4/teams/name/$WS" | jq -r '.id'; }

method="${1:-help}"; shift || true
case "$method" in
  auth.test)
    curl -s -H "Authorization: Bearer $(_token)" "$URL/api/v4/users/me" | jq '{ok:true, user:.username}' ;;

  conversations.list)
    # `--archived` lists archived channels; default lists active ones (Slack-shaped).
    tid="$(_team_id)"; tok="$(_token)"
    if [ "${1:-}" = "--archived" ]; then
      curl -s -H "Authorization: Bearer $tok" "$URL/api/v4/teams/$tid/channels/deleted?per_page=200" \
        | jq '[.[] | {id, name, is_archived:true}]'
    else
      curl -s -H "Authorization: Bearer $tok" "$URL/api/v4/teams/$tid/channels?per_page=200" \
        | jq '[.[] | {id, name, is_archived:((.delete_at//0)>0)}]'
    fi ;;
  conversations.info)
    ch="${1:?usage: slack conversations.info <channel>}"; tid="$(_team_id)"
    curl -s -H "Authorization: Bearer $(_token)" "$URL/api/v4/teams/$tid/channels/name/$ch" \
      | jq '{id, name, is_archived:((.delete_at//0)>0), is_private:(.type=="P"), purpose:.purpose}' ;;
  conversations.history)
    ch="${1:?usage: slack conversations.history <channel> [count]}"; n="${2:-30}"
    mmctl post list "$WS:$ch" -n "$n" ;;
  conversations.create)
    name="${1:?usage: slack conversations.create <name>}"
    mmctl channel create --team "$WS" --name "$name" --display-name "$name" ;;
  conversations.archive)
    mmctl channel archive "$WS:${1:?usage: slack conversations.archive <channel>}" ;;
  conversations.unarchive)
    mmctl channel unarchive "$WS:${1:?usage: slack conversations.unarchive <channel>}" ;;

  chat.postMessage)
    ch="${1:?usage: slack chat.postMessage <channel> <text...>}"; shift
    mmctl post create "$WS:$ch" -m "$*" ;;

  users.list)
    curl -s -H "Authorization: Bearer $(_token)" "$URL/api/v4/users?per_page=200" \
      | jq '[.[] | {id, name:.username, deleted:((.delete_at//0)>0)}]' ;;
  users.info)
    u="${1:?usage: slack users.info <user>}"
    curl -s -H "Authorization: Bearer $(_token)" "$URL/api/v4/users/username/$u" \
      | jq '{id, name:.username, real_name:.nickname, email, deleted:((.delete_at//0)>0)}' ;;

  admin.users.setActive)
    user="${1:?usage: slack admin.users.setActive <user> <true|false>}"; state="${2:-true}"
    if [ "$state" = "true" ]; then mmctl user activate "$user"; else mmctl user deactivate "$user"; fi ;;
  admin.getFileSharing)
    mmctl config get FileSettings.EnableFileAttachments ;;
  admin.setFileSharing)
    state="${1:?usage: slack admin.setFileSharing <true|false>}"
    mmctl config set FileSettings.EnableFileAttachments "$state" ;;

  help|-h|--help|"")
    cat <<'EOF'
slack — workspace CLI (Slack Web API style)

Conversations (channels):
  slack conversations.list [--archived]
  slack conversations.info       <channel>
  slack conversations.history    <channel> [count]
  slack conversations.create     <name>
  slack conversations.archive    <channel>
  slack conversations.unarchive  <channel>

Chat:
  slack chat.postMessage         <channel> <text...>

Users (members):
  slack users.list
  slack users.info               <user>

Admin:
  slack admin.users.setActive    <user> <true|false>
  slack admin.getFileSharing
  slack admin.setFileSharing     <true|false>
  slack auth.test

Tip: explore — some problems are only visible with the right method/flags.
EOF
    ;;

  *)
    mmctl "$method" "$@" ;;   # passthrough
esac
