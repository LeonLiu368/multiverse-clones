# dokku-service.yaml.snippet — the Dokku deploy-plane service block for a live
# task's docker-compose.yaml. Proven recipe (../README.md spike, step 0):
# socket-sibling mode + attach-post-create; app is reached DIRECTLY by container
# name (<app>.web.1:<port>) — the dokku nginx vhost proxy is NOT used (it
# targets the app's bridge IP, unreachable from the task network).
#
# Per-task isolation: DOKKU_HOST_ROOT / DOKKU_LIB_HOST_ROOT live under
# /var/lib/dokku-${COMPOSE_PROJECT_NAME} (a path on the docker HOST — the
# Docker Desktop VM on macOS), so parallel tasks never share dokku state.
# Cleanup of that path needs a helper container (see platform/smoke.sh).
#
# No published ports: everything (agent SSH, git push, app HTTP) happens over
# the task compose network, so parallel tasks can't collide on host ports.
# The dokku container itself is the SSH endpoint: `ssh dokku@dokku <cmd>`.

services:
  dokku:
    image: dokku/dokku:0.35.18
    hostname: dokku
    volumes:
      # socket-sibling: dokku drives the shared dockerd; app containers are
      # siblings on the same daemon (join the task network via
      # `dokku network:set <app> attach-post-create <task-network>`).
      - /var/run/docker.sock:/var/run/docker.sock
      # dokku persistent state, per task (host path inside the Docker VM).
      - /var/lib/dokku-${COMPOSE_PROJECT_NAME:-live}:/mnt/dokku
      # the SUT deploy repo source, baked/mounted by the task (read-only;
      # provision copies it to a rw tmp dir, git-inits it, `git:sync --build`s it).
      - ${SUT_REPO_DIR:?path to assembled SUT repo source}:/mnt/sut:ro
      # the agent's PUBLIC key, pre-generated by the task
      # (private half goes to the agent container).
      - ${AGENT_PUBKEY:?path to agent public key}:/mnt/keys/agent_key.pub:ro
    environment:
      DOKKU_HOSTNAME: dokku.local
      DOKKU_HOST_ROOT: /var/lib/dokku-${COMPOSE_PROJECT_NAME:-live}/home/dokku
      DOKKU_LIB_HOST_ROOT: /var/lib/dokku-${COMPOSE_PROJECT_NAME:-live}/var-lib-dokku
