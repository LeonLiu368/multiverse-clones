# Logfire AGENT (client) image — the matched pair to logfire-gateway.
# Bundles the `logfire` CLI + `logfire-mcp` server and NOTHING ELSE: no records, no server.
# The agent (or a task `main` image that COPYs these in) talks to the baked gateway via
# $LOGFIRE_URL / $LOGFIRE_TOKEN. Analogue of jira-agent / slack-agent / gauge-agent.
FROM mirror.gcr.io/library/python:3.12-slim

RUN pip install --no-cache-dir mcp \
    && apt-get update && apt-get install -y --no-install-recommends curl jq \
    && rm -rf /var/lib/apt/lists/*

COPY logfire_clone /opt/logfire_clone

# `logfire` (CLI) and `logfire-mcp` (stdio MCP) on PATH, both thin clients of the gateway.
RUN printf '#!/bin/sh\nexec python -m logfire_clone.cli "$@"\n'        > /usr/local/bin/logfire     && chmod +x /usr/local/bin/logfire \
 && printf '#!/bin/sh\nexec python -m logfire_clone.mcp_server "$@"\n' > /usr/local/bin/logfire-mcp && chmod +x /usr/local/bin/logfire-mcp

ENV PYTHONPATH=/opt \
    LOGFIRE_URL=http://logfire \
    LOGFIRE_TOKEN=test-token-acme-eval

# This image is a toolbox to copy from / run interactively — no long-running server.
CMD ["sleep", "infinity"]
