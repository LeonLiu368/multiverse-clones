    "type": "message",
    "ts": "1748014260.000000",
    "client_msg_id": "67280e598edeceeed9",
    "text": "OVERDRAFT=10 on top of CAPACITY=100 means up to 110 requests can burst. that's not what we told the downstream service owners",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "dave",
      "real_name": "Dave",
      "display_name": "dave",
      "team": "T0EXACME01",
