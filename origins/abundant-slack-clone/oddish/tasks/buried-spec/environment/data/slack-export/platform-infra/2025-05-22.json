    "type": "message",
    "ts": "1747905540.000000",
    "client_msg_id": "1e6f2581f66a599dac",
    "text": "ok I ran some numbers. my proposal: CAPACITY=200, REFILL_RATE=15.0",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "frank",
      "real_name": "Frank",
      "display_name": "frank",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
