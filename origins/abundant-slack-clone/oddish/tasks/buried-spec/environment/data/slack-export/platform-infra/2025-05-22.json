    "type": "message",
    "ts": "1747906560.000000",
    "client_msg_id": "3c260bc7ebcc83f683",
    "text": "agreed, CAPACITY=200 will let a misbehaving client hammer our downstream services",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "bob",
      "real_name": "Bob",
      "display_name": "bob",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U44844B8AA9",
    "type": "message",
    "ts": "1747906860.000000",
    "client_msg_id": "9ddc61926339ce3d51",
    "text": "what about CAPACITY=120? covers partner A at peak with 20% headroom",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "kate",
      "real_name": "Kate",
      "display_name": "kate",
      "team": "T0EXACME01",
      "is_restricted": false,
