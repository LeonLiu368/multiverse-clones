    "type": "message",
    "ts": "1747906920.000000",
    "client_msg_id": "aa7e11f8e1e0bce629",
    "text": "CAPACITY=200 is definitely too permissive. we need headroom above partner peaks but not 2x",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "dave",
      "real_name": "Dave",
      "display_name": "dave",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U522B276A35",
    "type": "message",
    "ts": "1747906980.000000",
    "client_msg_id": "d940fffb5e126f1d26",
    "text": "downstream services are sized for ~120 req/s. if we allow 200-token bursts we could overwhelm them",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "alice",
      "real_name": "Alice",
      "display_name": "alice",
      "team": "T0EXACME01",
      "is_restricted": false,
