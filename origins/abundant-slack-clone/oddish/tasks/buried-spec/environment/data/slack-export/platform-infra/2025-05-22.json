    "type": "message",
    "ts": "1747905360.000000",
    "client_msg_id": "d76c6cd5194428a454",
    "text": "hmm, CAPACITY=200 seems too high to me. that's 4x the current value",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "alice",
      "real_name": "Alice",
      "display_name": "alice",
      "team": "T0EXACME01",
      "is_restricted": false,
