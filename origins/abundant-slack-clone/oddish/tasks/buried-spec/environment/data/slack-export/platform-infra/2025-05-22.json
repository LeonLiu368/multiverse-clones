    "ts": "1747905240.000000",
    "client_msg_id": "abc803a43259e07787",
    "text": "CAPACITY=200 gives a big burst buffer. REFILL_RATE=15.0 means recovery from empty in ~13s",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "frank",
      "real_name": "Frank",
      "display_name": "frank",
      "team": "T0EXACME01",
