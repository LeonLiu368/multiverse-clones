    "type": "message",
    "ts": "1731166740.000000",
    "client_msg_id": "1c3bcc4e96226b9cad",
    "text": "Happy Friday people, great week \ud83c\udf89",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "dave",
      "real_name": "Dave",
      "display_name": "dave",
