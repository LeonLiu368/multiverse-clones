    "type": "message",
    "ts": "1731174780.000000",
    "client_msg_id": "206ecaf32b7498553a",
    "text": "Welcome to the new folks joining this week! \ud83d\udc4b",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "trent",
      "real_name": "Trent",
