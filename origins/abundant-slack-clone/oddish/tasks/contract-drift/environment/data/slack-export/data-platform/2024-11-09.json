  {
    "user": "UBFCDF3E6CA",
    "type": "message",
    "ts": "1731179580.000000",
    "client_msg_id": "86c8d9672dbffdda24",
    "text": "What type is `recorded_at` exactly? Our publisher uses a float currently.",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "dave",
      "real_name": "Dave",
      "display_name": "dave",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U6525ABCCE7",
    "type": "message",
    "ts": "1731195060.000000",
    "client_msg_id": "592ae05ee449a820a4",
    "text": "Integer milliseconds. Convert with `int(time.time() * 1000)`. The pipeline rejects float values \u2014 the type check is strict.",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "niaj",
      "real_name": "Niaj",
      "display_name": "niaj",
      "team": "T0EXACME01",
