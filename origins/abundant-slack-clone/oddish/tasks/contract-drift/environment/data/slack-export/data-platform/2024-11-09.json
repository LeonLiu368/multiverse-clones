  {
    "user": "U6525ABCCE7",
    "type": "message",
    "ts": "1731161100.000000",
    "client_msg_id": "02a11687a0ba045d87",
    "text": "\u26a0\ufe0f Correction on bob's message above: the field is **`actor_id`**, NOT `author_id`. `author_id` was used in an early internal draft but was dropped before the spec was finalised. The correct v2 field is `actor_id`. Please don't copy the `author_id` name from earlier messages in this thread.",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "niaj",
      "real_name": "Niaj",
      "display_name": "niaj",
      "team": "T0EXACME01",
      "is_restricted": false,
      "is_ultra_restricted": false
    }
  },
  {
    "user": "U48181ACD22",
    "type": "message",
    "ts": "1731166620.000000",
    "client_msg_id": "9d94944de5ed2d6513",
    "text": "Thanks for clarifying! Updated my PR \u2014 using `actor_id`. Sorry for the confusion.",
    "team": "T0EXACME01",
    "user_profile": {
      "name": "bob",
      "real_name": "Bob",
